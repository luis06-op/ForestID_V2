# ForestID - Protección de archivos y directorios sensibles
# Requiere Apache con mod_rewrite, mod_authz_core y AllowOverride All.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS en producción (compatible con proxies/LiteSpeed).
    # No se fuerza en entornos locales (localhost / 127.0.0.1) para evitar que
    # el navegador muestre "Conexión no privada" por el certificado autofirmado.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Carpetas internas: no accesibles por HTTP (sí por include de PHP).
    RewriteRule ^(?:\.git|\.opencode|database|docs|includes|config|vendor|scripts)(?:/|$) - [R=404,L]

    # Archivos de desarrollo, documentación y configuración.
    RewriteRule ^(?:composer\.(?:json|lock)|README\.md|test[0-9]*\.(?:html|js))$ - [R=404,L]
</IfModule>

# Detección de HTTPS compatible con Apache y LiteSpeed.
# mod_ssl expone la variable HTTPS=on; los proxies/CDN que terminan TLS
# suelen exponer X-Forwarded-Proto=https. No se usa la expresión <If>,
# que LiteSpeed no garantiza soportar y puede provocar errores 500.
<IfModule mod_setenvif.c>
    SetEnvIf HTTPS "on" HTTPS_ON=1
    SetEnvIf X-Forwarded-Proto "https" HTTPS_ON=1
</IfModule>

<FilesMatch "\.(?:sql|sqlite|sqlite3|db|dump|md|log|ini|sh|bash|bak|backup|old|orig|save|swp|swo|env|lock|conf|dist|zip|tar|tgz|gz|bz2|7z|rar)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    # M4: CSP (permite CDNs usados por el proyecto) + HSTS bajo HTTPS.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self'"
    # HSTS solo bajo HTTPS (LiteSpeed/Apache): SetEnvIf arriba marca HTTPS_ON.
    # No se usa <If> porque LiteSpeed no garantiza soportarlo.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS_ON
</IfModule>
