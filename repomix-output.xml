  fi

  local legacy_hash_input="${remote_url:-$project_root}"
  local normalized_remote=""
  if [ -n "$remote_url" ]; then
    normalized_remote=$(_clv2_normalize_remote_url "$remote_url")
  fi

  local fallback_root="$project_root"
