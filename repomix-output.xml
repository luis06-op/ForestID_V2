        if ($toggle_id === $_SESSION['usuario']['id_usuario']) {
            set_flash('error', 'No puede desactivar su propia cuenta de administrador.');
        } else {
            $stmt = $pdo->prepare("UPDATE `usuarios` SET `estado` = IF(estado = 1, 0, 1) WHERE `id_usuario` = :id");
