  cp .env.example .env
  echo "Created .env from .env.example — edit it with your values"
fi

# Dependencies
echo "Installing dependencies..."
{npm install | pip install -r requirements.txt | cargo build | go mod download}

echo ""
echo "=== Setup complete! ==="
echo ""
