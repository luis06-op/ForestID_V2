    SELECT a.*, u.nombres, u.apellidos
    FROM `actividades_mantenimiento` a
    LEFT JOIN `usuarios` u ON a.realizado_por = u.id_usuario
    WHERE a.id_individuo = :id
    ORDER BY a.fecha_actividad DESC
    LIMIT 10
");
